rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom claims are assigned by a trusted administrator, never a profile form.
    function isApprovedMember() {
      return request.auth != null && request.auth.token.get('controlObra', false) == true;
    }
    match /usuarios/{userId} {
      allow get, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{collectionName}/{documentId} {
      allow read, write: if isApprovedMember() && collectionName in [
        'projects', 'partidas', 'daily_reports', 'workers', 'materials', 'equipment',
        'incidents', 'photo_evidence', 'daily_inspections', 'foundation_schedule_tasks',
        'foundation_milestones', 'foundation_checks', 'test_connection'
      ];
    }
  }
}
